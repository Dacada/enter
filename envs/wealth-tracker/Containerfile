FROM archlinux:base

ARG UID=1000
ARG GID=1000

RUN pacman -Syu --noconfirm \
        emacs-nox git openssh the_silver_searcher \
        ruby ruby-bundler base-devel nodejs yarn \
        npm \
    && npm install --global @openai/codex \
    && pacman -Scc --noconfirm

RUN groupadd --gid "$GID" dev \
    && useradd \
        --uid "$UID" \
        --gid "$GID" \
        --create-home \
        --shell /bin/bash \
        dev

RUN printf '\nPS1="[$(< /run/container-icon)] \\w \\\$ "\n' >> /home/dev/.bashrc

ENV HOME=/home/dev
ENV BUNDLE_PATH=$HOME/.bundle/gems
ENV GEM_HOME=$HOME/.local/share/gem
ENV PATH=$GEM_HOME/bin:$PATH
ENV BINDING=0.0.0.0

USER dev

WORKDIR /home/dev
